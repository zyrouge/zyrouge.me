---
import type { HeadMetadata } from "@/core/metadata";
import { Metadata } from "@/core/metadata";
import Base from "@/layouts/Base.astro";
import Splash from "@/components/home/Splash.astro";
import Hero from "@/components/home/Hero.astro";
import Projects from "@/components/home/Projects.astro";
import Technologies from "@/components/home/Technologies.astro";
import { ExternalUrls } from "@/core/urls";

const head: HeadMetadata = {
    title: Metadata.constructTitle("Home"),
    description: "Hello there!",
    meta: {},
};
---

<Base head={head}>
    <hr />
    <Hero />
    <hr />
    <div class="u-container u-container-h">
        <p class="text-lg">What do I usually use?</p>
        <Technologies />
    </div>
    <hr />
    <div class="u-container-h pb-0!">
        <div class="u-container">
            <p class="text-lg">Some of my projects</p>
        </div>
        <Projects />
    </div>
    <div class="u-container w-full u-flex justify-between!">
        <div class="py-24 sm:py-32">
            <p class="pb-0.5">I'm open for various opportunities!</p>
            <p class="pb-4">Feel free to reach out to me via</p>
            <a
                href={ExternalUrls.mail}
                class="text-primary-500 text-2xl sm:text-5xl font-bold hover:underline"
            >
                {ExternalUrls.mail.replace(/^mailto:/, "")}
            </a>
        </div>
        <div class="hidden lg:block">
            <div class="[clip-path:circle()]">
                <a href={ExternalUrls.github}>
                    <img
                        src="https://avatars.githubusercontent.com/u/50770114"
                        class="h-56 w-auto"
                    />
                </a>
            </div>
        </div>
    </div>

    <Splash />
    <script src="../assets/scripts/home.ts"></script>
</Base>
