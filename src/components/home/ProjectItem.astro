---
import { Icon } from "astro-icon/components";
import { Utils } from "@/core/utils";
import sugar from "sugar";

interface Props {
    name: string;
    description: string;
    link: string;
    image: string;
    tags: string[];
    backgroundColor: string;
    stars?: number;
}

const { name, description, link, image, tags, backgroundColor, stars } =
    Astro.props;
---

<div
    class:list={[
        "u-container min-h-screen u-flex pt-28 md:pt-32 pb-16 md:pb-32 u-flex flex-col!",
        backgroundColor,
    ]}
    id="project-item"
>
    <img
        class="max-h-[40%] max-w-[80%] sm:max-w-[40%]"
        id="project-item-logo"
        src={image}
        alt={`${name}'s logo`}
        loading="lazy"
    />
    <div class="block h-10" id="project-item-spacer"></div>
    <p
        class="text-lg text-center"
        id="project-item-description"
        set:html={Utils.renderSimpleMarkdown(description)}
    />
    <div
        class="mt-1 u-flex flex-wrap gap-x-2 gap-y-1"
        id="project-item-link-container"
    >
        <a
            class="group border-b border-white/30 hover:border-white transition duration-200"
            href={link}
            target="_blank"
        >
            {link}
            <Icon
                class="inline-block text-white/75 group-hover:text-white transition duration-200"
                name="mdi:arrow-top-right"
            />
        </a>
        {stars && (
            <p class="text-center text-yellow-400">
                <Icon name="mdi:star" class="inline-block -translate-y-0.5" />
                {sugar.Number.abbr(stars, 1)}+
            </p>
        )}
    </div>
    <div class="mt-1.5" id="project-item-tags-container">
        <div class="u-flex flex-wrap gap-x-2 gap-y-1 text-white hover:text-white transition duration-200">
            {tags.map((x) => (
                <p>#{x}</p>
            ))}
        </div>
    </div>
</div>
