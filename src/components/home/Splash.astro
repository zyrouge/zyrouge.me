---
import { Metadata } from "@/core/metadata";
---

<div
    class="hidden fixed inset-0 bg-secondary-950 pointer-events-none"
    id="splash"
>
    <div class="u-flex h-full">
        <p class="opacity-0 absolute text-4xl sm:text-7xl" id="splash-title">
            <span class="text-primary-500 font-bold">{Metadata.title}</span>
        </p>
        <p class="opacity-0 absolute text-5xl sm:text-7xl" id="splash-hi">
            👋
        </p>
    </div>
</div>

<style scoped>
    @media (scripting: enabled) {
        #splash {
            display: block;
        }
    }
</style>
