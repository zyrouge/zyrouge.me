{
    "name": "zyrouge.me",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "npm run astro:dev",
        "build": "npm run astro:check && npm run typescript:check && npm run astro:build",
        "deploy": "gh workflow run deploy",
        "lint": "npm run prettier:check && npm run astro:check && npm run typescript:check",
        "typescript:check": "tsc --noEmit",
        "astro:check": "astro check",
        "astro:dev": "astro dev",
        "astro:build": "astro build",
        "prettier:check": "prettier . --check",
        "prettier:format": "prettier . --write"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.11",
        "@astrojs/mdx": "^8.1.0",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/simple-icons": "^1.2.100",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.4.1",
        "astro-icon": "^1.2.0",
        "fuse.js": "^7.5.0",
        "gsap": "^3.15.0",
        "sugar": "^2.0.6",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1"
    }
}
