{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "jsx": "preserve",
        "paths": {
            "@/*": ["./src/*"]
        },
        "noUnusedLocals": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedParameters": true,
        "strictNullChecks": true,
        "allowJs": true
    },
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"]
}
